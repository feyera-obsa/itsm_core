{
    "doctype": "DocType",
    "name": "Grafana Webhook Log",
    "module": "ITSM Core",
    "custom": 0,
    "track_changes": 1,
    "fields": [
        {
            "fieldname": "payload",
            "label": "Payload",
            "fieldtype": "Code",
            "reqd": 1
