{
    "doctype": "DocType",
    "name": "Change Request",
    "module": "ITSM Core",
    "custom": 0,
    "autoname": "CRQ-.YYYY.-.#####",
    "is_submittable": 0,
    "track_changes": 1,
    "quick_entry": 1,
    "track_seen": 1,
    "fields": [
        {
            "fieldname": "section_basics",
            "fieldtype": "Section Break",
            "label": "Basics"
        },
        {
            "fieldname": "title",
            "label": "Title",
            "fieldtype": "Data",
            "reqd": 1,
            "in_list_view": 1,
            "in_standard_filter": 1
        },
        {
            "fieldname": "change_type",
            "label": "Change Type",
            "fieldtype": "Select",
            "options": "Standard\nNormal\nEmergency",
            "reqd": 1,
            "in_list_view": 1,
            "in_standard_filter": 1
        },
        {
            "fieldname": "risk_level",
            "label": "Risk Level",
            "fieldtype": "Select",
            "options": "Low\nMedium\nHigh\nCritical",
            "read_only": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "section_services",
            "fieldtype": "Section Break",
            "label": "Services and Schedule"
        },
        {
            "fieldname": "affected_services",
            "label": "Affected Services",
            "fieldtype": "Table",
            "options": "Change Request Affected Service",
            "in_list_view": 1,
            "reqd": 1
        },
        {
            "fieldname": "scheduled_start",
            "label": "Scheduled Start",
            "fieldtype": "Datetime",
            "width": "180px",
            "reqd": 1,
            "mandatory_depends_on": "eval:doc.change_type!='Emergency'"
        },
        {
            "fieldname": "scheduled_end",
            "label": "Scheduled End",
            "fieldtype": "Datetime",
            "width": "180px",
            "reqd": 1,
            "mandatory_depends_on": "eval:doc.change_type!='Emergency'"
        },
        {
            "fieldname": "scheduled_window",
            "label": "Scheduled Window (deprecated)",
            "fieldtype": "Datetime",
            "width": "180px",
            "hidden": 1
        },
        {
            "fieldname": "section_why_what",
            "fieldtype": "Section Break",
            "label": "Why and What"
        },
        {
            "fieldname": "justification",
            "label": "Justification / Business Impact",
            "fieldtype": "Small Text",
            "reqd": 1
        },
        {
            "fieldname": "implementation_steps",
            "label": "Implementation Steps",
            "fieldtype": "Text Editor",
            "reqd": 1
        },
        {
            "fieldname": "section_risk",
            "fieldtype": "Section Break",
            "label": "Risk Assessment"
        },
        {
            "fieldname": "change_category",
            "label": "Change Category",
            "fieldtype": "Select",
            "options": "Code\nConfig\nInfrastructure\nData\nOther",
            "reqd": 1,
            "in_list_view": 1,
            "in_standard_filter": 1
        },
        {
            "fieldname": "security_impact",
            "label": "Security Impact",
            "fieldtype": "Select",
            "options": "None expected\nLow\nNeeds security review",
            "default": "None expected",
            "reqd": 0
        },
        {
            "fieldname": "environment",
            "label": "Environment",
            "fieldtype": "Select",
            "options": "Production\nStaging\nOther",
            "default": "Production",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "impact",
            "label": "Impact",
            "fieldtype": "Select",
            "options": "1 - Low\n2 - Medium\n3 - High\n4 - Critical",
            "depends_on": "eval:doc.change_type!='Standard'"
        },
        {
            "fieldname": "likelihood",
            "label": "Likelihood",
            "fieldtype": "Select",
            "options": "1 - Rare\n2 - Unlikely\n3 - Possible\n4 - Likely\n5 - Certain",
            "depends_on": "eval:doc.change_type!='Standard'"
        },
        {
            "fieldname": "computed_risk_score",
            "label": "Computed Risk Score",
            "fieldtype": "Int",
            "read_only": 1,
            "in_list_view": 1,
            "depends_on": "eval:doc.change_type!='Standard'"
        },
        {
            "fieldname": "section_safety",
            "fieldtype": "Section Break",
            "label": "Safety",
            "collapsible": 1
        },
        {
            "fieldname": "rollback_plan",
            "label": "Rollback Plan",
            "fieldtype": "Small Text",
            "reqd": 1
        },
        {
            "fieldname": "validation_criteria",
            "label": "Validation Criteria",
            "fieldtype": "Text Editor",
            "depends_on": "eval:doc.change_type!='Standard'",
            "mandatory_depends_on": "eval:doc.change_type=='Normal'"
        },
        {
            "fieldname": "section_cicd",
            "fieldtype": "Section Break",
            "label": "CI/CD",
            "collapsible": 1,
            "depends_on": "eval:doc.change_category=='Code'"
        },
        {
            "fieldname": "repo",
            "label": "Repo",
            "fieldtype": "Data",
            "width": "200px",
            "in_standard_filter": 1,
            "mandatory_depends_on": "eval:doc.change_category=='Code'"
        },
        {
            "fieldname": "linked_pr_url",
            "label": "Linked PR URL",
            "fieldtype": "Data",
            "options": "URL",
            "width": "200px"
        },
        {
            "fieldname": "section_system",
            "fieldtype": "Section Break",
            "label": "System",
            "collapsible": 1,
            "depends_on": "eval:!doc.__islocal"
        },
        {
            "fieldname": "approved_by",
            "label": "Approved By",
            "fieldtype": "Link",
            "options": "User",
            "read_only": 1,
            "allow_on_submit": 1
        },
        {
            "fieldname": "emergency_authorized_by",
            "label": "Emergency Authorized By",
            "fieldtype": "Link",
            "options": "User",
            "read_only": 1,
            "allow_on_submit": 1
        },
        {
            "fieldname": "retro_review_due",
            "label": "Retro Review Due",
            "fieldtype": "Datetime",
            "read_only": 1,
            "allow_on_submit": 1
        },
        {
            "fieldname": "deployment_evidence",
            "label": "Deployment Evidence",
            "fieldtype": "Text",
            "read_only": 1,
            "allow_on_submit": 1
        },
        {
            "fieldname": "implemented_on",
            "label": "Implemented On",
            "fieldtype": "Datetime",
            "read_only": 1,
            "allow_on_submit": 1
        },
        {
            "fieldname": "implementer",
            "label": "Implementer",
            "fieldtype": "Link",
            "options": "User"
        },
        {
            "fieldname": "related_ticket",
            "label": "Related Ticket",
            "fieldtype": "Link",
            "options": "HD Ticket"
        },
        {
            "fieldname": "outcome",
            "label": "Outcome",
            "fieldtype": "Select",
            "options": "Successful\nSuccessful with issues\nRolled back\nFailed",
            "allow_on_submit": 1,
            "depends_on": "eval:[\\\"Implemented\\\",\\\"Post-Implementation Review\\\",\\\"Closed\\\"].includes(doc.workflow_state)",
            "mandatory_depends_on": "eval:doc.workflow_state==\\\"Closed\\\""
        },
        {
            "fieldname": "pir_notes",
            "label": "PIR Notes",
            "fieldtype": "Small Text",
            "allow_on_submit": 1,
            "depends_on": "eval:[\\\"Implemented\\\",\\\"Post-Implementation Review\\\",\\\"Closed\\\"].includes(doc.workflow_state)"
        },
        {
            "fieldname": "rejection_reason",
            "label": "Rejection Reason",
            "fieldtype": "Small Text",
            "depends_on": "eval:doc.workflow_state==\\\"Rejected\\\"",
            "mandatory_depends_on": "eval:doc.workflow_state==\\\"Rejected\\\""
        },
        {
            "fieldname": "workflow_state",
            "label": "Workflow State",
            "fieldtype": "Read Only",
            "read_only": 1,
            "allow_on_submit": 1,
            "in_list_view": 1,
            "in_standard_filter": 1
        }
    ],
    "permissions": [
        {
            "role": "Change Requester",
            "read": 1,
            "write": 1,
            "create": 1
        },
        {
            "role": "Change Approver",
            "read": 1,
            "write": 1
        },
        {
            "role": "Change Implementer",
            "read": 1,
            "write": 1
        },
        {
            "role": "Change Manager",
            "read": 1,
            "write": 1
        },
        {
            "role": "System Manager",
            "read": 1,
            "write": 1,
            "create": 1
        }
    ],
    "modified": "2026-10-28 14:00:00.000000"
}