{
    "doctype": "DocType",
    "name": "Change Request",
    "module": "ITSM Core",
    "custom": 0,
    "autoname": "CRQ-{YYYY}-{#####}",
    "is_submittable": 1,
    "track_changes": 1,
    "quick_entry": 1,
    "track_seen": 1,
    "fields": [
        {
            "fieldname": "title",
            "label": "Title",
            "fieldtype": "Data",
            "reqd": 1,
            "in_list_view": 1,
            "in_standard_filter": 1
        },
        {
            "fieldname": "change_type",
            "label": "Change Type",
            "fieldtype": "Select",
            "options": "Standard\nNormal\nEmergency",
            "reqd": 1,
            "in_list_view": 1,
            "in_standard_filter": 1
        },
        {
            "fieldname": "risk_level",
            "label": "Risk Level",
            "fieldtype": "Select",
            "options": "Low\nMedium\nHigh\nCritical",
            "read_only": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "impact",
            "label": "Impact",
            "fieldtype": "Select",
            "options": "1 - Low\n2 - Medium\n3 - High\n4 - Critical",
            "depends_on": "eval:doc.change_type!='Standard'"
        },
        {
            "fieldname": "likelihood",
            "label": "Likelihood",
            "fieldtype": "Select",
            "options": "1 - Rare\n2 - Unlikely\n3 - Possible\n4 - Likely\n5 - Certain",
            "depends_on": "eval:doc.change_type!='Standard'"
        },
        {
            "fieldname": "computed_risk_score",
            "label": "Computed Risk Score",
            "fieldtype": "Int",
            "read_only": 1,
            "in_list_view": 1,
            "depends_on": "eval:doc.change_type!='Standard'"
        },
        {
            "fieldname": "justification",
            "label": "Justification / Business Impact",
            "fieldtype": "Text Editor",
            "reqd": 1
        },
        {
            "fieldname": "implementation_steps",
            "label": "Implementation Steps",
            "fieldtype": "Text Editor",
            "reqd": 1
        },
        {
            "fieldname": "rollback_plan",
            "label": "Rollback Plan",
            "fieldtype": "Text Editor",
            "depends_on": "eval:doc.change_type!='Standard'",
            "mandatory_depends_on": "eval:doc.change_type=='Normal'"
        },
        {
            "fieldname": "validation_criteria",
            "label": "Validation Criteria",
            "fieldtype": "Text Editor",
            "depends_on": "eval:doc.change_type!='Standard'",
            "mandatory_depends_on": "eval:doc.change_type=='Normal'"
        },
        {
            "fieldname": "affected_services",
            "label": "Affected Services",
            "fieldtype": "Table",
            "options": "Change Request Affected Service",
            "in_list_view": 1,
            "reqd": 1
        },
        {
            "fieldname": "repo",
            "label": "Repo",
            "fieldtype": "Data",
            "width": "200px",
            "in_standard_filter": 1
        },
        {
            "fieldname": "linked_pr_url",
            "label": "Linked PR URL",
            "fieldtype": "Data",
            "options": "URL",
            "width": "200px"
        },
        {
            "fieldname": "scheduled_window",
            "label": "Scheduled Window",
            "fieldtype": "Datetime",
            "width": "180px"
        },
        {
            "fieldname": "deployment_evidence",
            "label": "Deployment Evidence",
            "fieldtype": "Text",
            "read_only": 1,
            "allow_on_submit": 1
        },
        {
            "fieldname": "emergency_authorized_by",
            "label": "Emergency Authorized By",
            "fieldtype": "Link",
            "options": "User",
            "read_only": 1,
            "allow_on_submit": 1
        },
        {
            "fieldname": "retro_review_due",
            "label": "Retro Review Due",
            "fieldtype": "Datetime",
            "read_only": 1,
            "allow_on_submit": 1
        },
        {
            "fieldname": "approved_by",
            "label": "Approved By",
            "fieldtype": "Link",
            "options": "User",
            "read_only": 1,
            "allow_on_submit": 1
        },
        {
            "fieldname": "workflow_state",
            "label": "Workflow State",
            "fieldtype": "Read Only",
            "read_only": 1,
            "in_list_view": 1,
            "in_standard_filter": 1
        }
    ],
    "permissions": [
        {
            "role": "Change Requester",
            "read": 1,
            "write": 1,
            "create": 1,
            "submit": 1
        },
        {
            "role": "Change Approver",
            "read": 1,
            "write": 1,
            "submit": 1
        },
        {
            "role": "Change Implementer",
            "read": 1,
            "write": 1
        },
        {
            "role": "Change Manager",
            "read": 1,
            "write": 1,
            "submit": 1,
            "cancel": 1
        },
        {
            "role": "System Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1,
            "submit": 1,
            "cancel": 1
        }
    ]
}